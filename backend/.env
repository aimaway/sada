# Database Configuration
DATABASE_URL=sqlite:///./dev.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# JWT Configuration
SECRET_KEY=test-secret-dev-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
APP_NAME=mecaGO
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
API_V1_STR=/api/v1

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://mecago.app"]

# Payment Configuration
CMI_API_KEY=your-cmi-api-key
CMI_MERCHANT_ID=your-merchant-id
ORANGE_MONEY_API_KEY=your-orange-money-api-key
ORANGE_MONEY_MERCHANT_ID=your-orange-merchant-id
INWI_MONEY_API_KEY=your-inwi-money-api-key

# Notification Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_PROJECT_ID=your-project-id

# Maps Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
DEFAULT_RADIUS_KM=10

# Auto-close Configuration
AUTO_CLOSE_HOURS=24
AUTO_CLOSE_CHECK_INTERVAL_MINUTES=5

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
