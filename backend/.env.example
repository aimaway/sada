# Environment variables for MécaCasablanca Backend

# App
APP_NAME=MécaCasablanca API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mecacasablanca

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://mecacasablanca.ma"]

# Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mecacasablanca

# SMS/WhatsApp (Mock in dev)
SMS_PROVIDER=mock
SMS_API_KEY=

# Maps
MAPS_PROVIDER=mock
MAPS_API_KEY=

# Demo mode
DEMO_MODE=True
