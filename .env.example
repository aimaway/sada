# ============================================================
# TomoBily / IFIX — PWA React (Vite) — Variables d'environnement
# Copier ce fichier vers `.env.local` puis adapter les valeurs.
# Les variables doivent commencer par VITE_ pour être exposées au client.
# ============================================================

# --- API backend (FastAPI) ---
# Défaut si non défini : http://localhost:8000
VITE_API_URL=http://localhost:8000

# --- Réseaux sociaux (page Contact de la PWA) ---
# Laisser vide = icônes affichées mais désactivées (aucun lien mort en production).
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=
